    {
      "type": "text",
      "id": "t1_desc",
      "x": 140,
      "y": 337,
      "width": 624.4999999999999,
      "height": 67.19999999999999,
      "text": "Career Explorer maps the job market against your actual skills, surfacing roles you're\ngenuinely qualified for — including ones you hadn't considered. LinkedIn Job Scanner\nruns daily across configurable search scopes, hard-filters on location, comp, and\nemployment type, then LLM-scores the rest so only the strongest matches reach you.",
      "originalText": "Career Explorer maps the job market against your actual skills, surfacing roles you're genuinely qualified for — including ones you hadn't considered. LinkedIn Job Scanner runs daily across configurable search scopes, hard-filters on location, comp, and employment type, then LLM-scores the rest so only the strongest matches reach you.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
