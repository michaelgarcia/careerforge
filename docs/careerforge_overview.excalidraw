    {
      "type": "text",
      "id": "v6_desc",
      "x": 73,
      "y": 780.5,
      "width": 408,
      "height": 55,
      "text": "Files over databases. Prompt engineering over code. A bash loop over a batch framework. Complexity is a cost — paid only when the benefit is clear and immediate.",
      "originalText": "Files over databases. Prompt engineering over code. A bash loop over a batch framework. Complexity is a cost — paid only when the benefit is clear and immediate.",
