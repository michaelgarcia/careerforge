    {"type":"text","id":"t1_label","x":140,"y":256,"width":640,"height":16,"text":"DISCOVER & FILTER","originalText":"DISCOVER & FILTER","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#c2410c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":10013,"version":1,"versionNonce":10014,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"t1_headline","x":140,"y":275,"width":640,"height":26,"text":"Find roles worth pursuing","originalText":"Find roles worth pursuing","fontSize":20,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":10015,"version":1,"versionNonce":10016,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"t1_metric","x":140,"y":309,"width":640,"height":20,"text":"354 jobs scanned → 9 top matches surfaced automatically","originalText":"354 jobs scanned → 9 top matches surfaced automatically","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#c2410c","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":10017,"version":1,"versionNonce":10018,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"t1_desc","x":140,"y":337,"width":640,"height":90,"text":"Career Explorer maps the job market against your actual skills, surfacing roles you're genuinely qualified for — including ones you hadn't considered. LinkedIn Job Scanner runs daily across configurable search scopes, hard-filters on location, comp, and employment type, then LLM-scores the rest so only the strongest matches reach you.","originalText":"Career Explorer maps the job market against your actual skills, surfacing roles you're genuinely qualified for — including ones you hadn't considered. LinkedIn Job Scanner runs daily across configurable search scopes, hard-filters on location, comp, and employment type, then LLM-scores the rest so only the strongest matches reach you.","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":10019,"version":1,"versionNonce":10020,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
