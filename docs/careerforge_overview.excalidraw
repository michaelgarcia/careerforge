    {
      "type": "text",
      "id": "t2_desc",
      "x": 880,
      "y": 337,
      "width": 636,
      "height": 67.19999999999999,
      "text": "Point the Resume Writer at any job posting and it generates a tailored .docx —\nachievements reordered, keywords matched, qualification gaps flagged — grounded entirely\nin your verified knowledge base. The Cover Letter agent does the same, adding company\nresearch it pulls fresh from the web.",
      "originalText": "Point the Resume Writer at any job posting and it generates a tailored .docx — achievements reordered, keywords matched, qualification gaps flagged — grounded entirely in your verified knowledge base. The Cover Letter agent does the same, adding company research it pulls fresh from the web.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
