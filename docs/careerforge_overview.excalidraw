    {
      "type": "text",
      "id": "t1_metric",
      "x": 140,
      "y": 309,
      "width": 586.5234375,
      "height": 16.25,
      "text": "Find jobs that fit your skills and create top matches every day automatically",
      "originalText": "Find jobs that fit your skills and create top matches every day automatically",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
