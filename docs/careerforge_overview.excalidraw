    {
      "type": "text",
      "id": "v7_desc",
      "x": 537,
      "y": 780.5,
      "width": 408,
      "height": 55,
      "text": "The agents' capabilities live in their system prompts, not in application code. Invest in prompt refinement; keep orchestration minimal. Prompts are the product.",
      "originalText": "The agents' capabilities live in their system prompts, not in application code. Invest in prompt refinement; keep orchestration minimal. Prompts are the product.",
