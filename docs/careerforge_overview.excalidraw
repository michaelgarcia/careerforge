    {
      "type": "text",
      "id": "v9_desc",
      "x": 1465,
      "y": 780.5,
      "width": 408,
      "height": 55,
      "text": "Idempotent outputs written to predictable paths. Re-running with the same inputs produces a clean new output — it never corrupts or silently overwrites previous work.",
      "originalText": "Idempotent outputs written to predictable paths. Re-running with the same inputs produces a clean new output — it never corrupts or silently overwrites previous work.",
